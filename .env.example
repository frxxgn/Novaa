# =============================================================================
# NOVALIUS · Variables de entorno
# Copia este archivo a .env.local (desarrollo) o configúralas en Vercel
# (Settings → Environment Variables). NUNCA subas claves reales al repositorio.
# Las variables con prefijo VITE_ se incluyen en el navegador: solo valores públicos.
# =============================================================================

# --- URL pública -------------------------------------------------------------
# Dominio definitivo (canonical, sitemap, enlaces de correos y control CSRF).
SITE_URL=http://localhost:5173

# --- Supabase (base de datos, autenticación y archivos) ----------------------
# Panel de Supabase → Project Settings → API.
# URL del proyecto. En previsualizaciones con proxy puede ser relativa: /supabase
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Clave publicable (antes «anon»). Es pública: la seguridad la aplica RLS.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor: misma URL y claves para la API.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (antes «service_role»). SOLO servidor. Omite RLS: protégela.
SUPABASE_SECRET_KEY=

# --- Inteligencia artificial (Nova) ------------------------------------------
# Sin esta clave Nova funciona en «modo guiado» (cualificación y presupuesto sin IA).
# console.anthropic.com → API Keys. Se factura por uso (tokens).
ANTHROPIC_API_KEY=
# Opcional: fuerza un modelo distinto del configurado en el panel.
NOVA_MODEL=
# Opcional: fallbacks automáticos de modelo ante rechazos (true por defecto).
NOVA_SERVER_FALLBACKS=true

# --- Correo (avisos al equipo) -----------------------------------------------
# EMAIL_PROVIDER=smtp  → cualquier servidor SMTP (p. ej. Gmail con contraseña de aplicación)
# EMAIL_PROVIDER=resend → API de Resend (requiere dominio verificado)
EMAIL_PROVIDER=
EMAIL_FROM="Novalius <webnovalius@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

# --- WhatsApp Business Cloud API (Meta) · opcional ---------------------------
# Requiere cuenta de WhatsApp Business, número verificado y plantilla aprobada.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# --- Seguridad ---------------------------------------------------------------
# Sal para anonimizar IP en los límites de uso (cadena aleatoria larga).
APP_HASH_SALT=
# Secreto de las tareas programadas (Vercel Cron lo envía automáticamente).
CRON_SECRET=
# Confiar en X-Forwarded-For (true detrás de Vercel o de un proxy de confianza).
TRUST_PROXY=true

# --- Solo para server/node.ts (previsualización fuera de Vercel) ---------------
PORT=4173
# Si se define, /supabase/* se reenvía a esta URL (todo bajo un mismo origen).
SUPABASE_PROXY_TARGET=
