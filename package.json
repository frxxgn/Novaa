{
  "name": "novalius",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Novalius: plataforma digital, asistente Nova, CRM, portal de clientes y panel administrativo",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && vite build",
    "preview": "tsx server/node.ts",
    "start": "NODE_ENV=production tsx server/node.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:rls": "node scripts/test-rls.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "db:start": "supabase start -x imgproxy,supavisor,vector,logflare,postgres-meta",
    "db:reset": "supabase db reset",
    "db:stop": "supabase stop",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "brand": "node scripts/generate-brand.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "~1.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/oswald": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@hono/node-server": "^2.1.6",
    "@react-three/fiber": "^9.8.2",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.18",
    "lenis": "^1.3.27",
    "lucide-react": "^1.72.0",
    "motion": "^14.12.0",
    "nodemailer": "^10.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "three": "^0.187.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "supabase": "^3.1.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
